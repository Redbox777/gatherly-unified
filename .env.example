# Copy to .env locally; never commit .env
APP_ENV=development
GATHERLY_DATABASE_PATH=var/gatherly.sqlite3
TELEGRAM_BOT_TOKEN=

# SMTP delivery for verification, password reset, and participant invitations
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@gatherly.local
SMTP_STARTTLS=true
SMTP_TIMEOUT=10

# Set these to routes handled by the web client in the deployed environment.
# Production requires HTTPS URLs and COOKIE_SECURE=true.
EMAIL_VERIFICATION_URL=http://localhost:8000/auth/verify-email
PASSWORD_RESET_URL=http://localhost:8000/reset-password
PARTICIPANT_INVITATION_URL=http://localhost:8000/accept-invitation
COOKIE_SECURE=true
